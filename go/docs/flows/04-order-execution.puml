@startuml Order Execution Flow
!theme plain

participant "Manager" as MGR
participant "Trader" as TDR
participant "Exchange Provider" as EXC
participant "Market Provider" as MKT
database "PostgreSQL" as DB

MGR -> MGR: ExecuteDecision(trader, decision)
activate MGR

== Pre-execution Validation ==
MGR -> MGR: Validate decision params
note right
  - Symbol not empty
  - Position size >= 0
  - Valid action
end note

alt Action = close_long/close_short
    MGR -> MGR: ensureCloseOwnership()
    note right: Verify trader owns position

    == Close Position Flow ==
    MGR -> MKT: Snapshot(symbol)
    MKT --> MGR: Market price
    MGR -> EXC: SetMarkPrice(symbol, price)
    MGR -> EXC: CancelAllBySymbol(symbol)
    note right: Cancel resting orders

    MGR -> EXC: ClosePosition(symbol)
    activate EXC
    EXC -> EXC: Execute market close
    EXC --> MGR: OrderResponse
    deactivate EXC

    MGR -> MGR: parseOrderFill(response)
    note right
      Extract fill price/qty
      Log if parse fails
    end note

    MGR -> MGR: Log execution details
    note right
      Structured log:
      - Order response status
      - Fill price/qty/timestamp
      - Expected vs actual qty
    end note

    MGR -> TDR: Update Cooldown[symbol] (in-memory)

    note right
      **H4: Cooldown Persistence**
      Must persist to survive restart
    end note

    MGR -> DB: UpsertCooldown(record)
    activate DB
    DB --> MGR: Result
    deactivate DB

    alt DB write failed
        MGR -> MGR: Log error: Cooldown persistence failed
        MGR -> MGR: Add to retry queue

        note right
          **Retry strategy**:
          - Max 3 retries with exponential backoff
          - If all fail, log CRITICAL
          - Cooldown still enforced in-memory
          - Manual reconciliation may be needed on restart
        end note

        MGR -> MGR: Schedule async retry
    else DB write succeeded
        MGR -> MGR: Confirm cooldown persisted
        note right: Safe to restart without losing cooldown
    end

    MGR -> MGR: recordPositionEvent(CLOSE)
    MGR -> MGR: releaseVirtualPosition()

else Action = open_long/open_short
    MGR -> MGR: ensureSymbolAvailable()
    note right: Check symbol not in use

    == Open Position Flow ==
    MGR -> MGR: Resolve leverage
    note right
      Use decision.Leverage or
      trader's major/alt defaults
    end note

    MGR -> MGR: enforceSecondaryRisk()
    note right
      - Check allocation limits
      - Validate notional size
      - Check existing positions
    end note

    MGR -> EXC: GetAssetIndex(symbol)
    EXC --> MGR: assetIdx
    MGR -> EXC: UpdateLeverage(assetIdx, leverage)
    note right: Best-effort, error ignored

    alt Entry price not provided
        MGR -> MKT: Snapshot(symbol)
        MKT --> MGR: Current price + timestamp

        MGR -> MGR: age = now() - snap.Timestamp
        note right
          **H3: Price Staleness Check**
          Critical for execution quality
        end note

        alt age > MaxAllowedAge (e.g., 2s)
            MGR -> MGR: Log warning: Stale price

            alt age > CriticalAge (e.g., 5s)
                MGR -> MGR: Reject order
                note right
                  **Price too stale, abort**:
                  - Market may have moved significantly
                  - Refetch or skip this cycle
                  - Severity: CRITICAL
                end note
                MGR --> MGR: Return error(stale_price)

            else Moderate staleness (2-5s)
                MGR -> MGR: Widen slippage tolerance
                note right
                  **Conservative execution**:
                  MarketIOCSlippageBps *= 1.5
                  Compensate for potential price movement
                end note
            end
        end

        MGR -> MGR: price = snap.Price.Last
        MGR -> MGR: Log snapshot timestamp
        note right
          Log for audit:
          - Snapshot time
          - Price source
          - Age of data
          - Staleness action taken
        end note
    end

    MGR -> EXC: SetMarkPrice(symbol, price)
    MGR -> MGR: Calculate qty = notional / price

    alt OrderStyle = market_ioc
        MGR -> MGR: Calculate slippage
        MGR -> MGR: Log order preparation
        note right
          Log:
          - Symbol, side, qty
          - Raw price, slippage
          - Notional USD
        end note
        MGR -> EXC: IOCMarket(symbol, isBuy, qty, slippage)
        activate EXC
        EXC -> EXC: Execute IOC market order
        EXC --> MGR: OrderResponse
        deactivate EXC

    else OrderStyle = limit_ioc
        MGR -> EXC: FormatPrice(symbol, price)
        EXC --> MGR: priceStr
        MGR -> EXC: FormatSize(symbol, qty)
        EXC --> MGR: sizeStr
        MGR -> MGR: buildCloid()
        note right
          CLOID = hash(trader+symbol+qty+time)
          Provides natural deduplication
        end note

        MGR -> MGR: Log order preparation
        note right
          Log:
          - CLOID, asset_idx
          - Price/size (raw + formatted)
          - Leverage
        end note

        MGR -> EXC: PlaceOrder(limitIOC)
        activate EXC
        EXC -> EXC: Execute limit IOC order
        EXC --> MGR: OrderResponse
        deactivate EXC
    end

    == Post-execution Validation & Setup ==
    MGR -> MGR: parseOrderFill(response)
    note right
      Extract: fillPrice, fillQty
      Fallback to request params if parse fails
    end note

    alt Order Fully Filled
        MGR -> MGR: Log order response
        note right
          Structured log:
          - Order status: filled
          - Fill price/qty
          - Execution timestamp
        end note

        alt Stop-loss/Take-profit supported
            MGR -> EXC: SetStopLoss(symbol, side, qty, sl)
            activate EXC
            EXC --> MGR: SL Response
            deactivate EXC

            note right
              **H2: Stop-Loss Protection**
              Critical for position safety
            end note

            alt SL set failed
                MGR -> MGR: Log CRITICAL error
                MGR -> MGR: Increment SL failure counter

                alt SL failure count > MaxSLRetries (3)
                    MGR -> MGR: Log EMERGENCY: Cannot set SL
                    MGR -> EXC: ClosePosition(symbol)
                    note right
                      **Fail-safe mechanism**:
                      If cannot set SL after retries,
                      close position immediately.

                      Better miss profit than risk loss.
                      Alert operator immediately.
                    end note

                else Retry allowed
                    MGR -> MGR: Schedule async SL retry (1s later)
                    note right: Background task will retry
                end

            else SL set successfully
                MGR -> DB: RecordStopLoss(position_id, sl_order_id)
                MGR -> MGR: Start SL monitoring task
                note right: RiskRunner will verify SL active
            end

            MGR -> EXC: SetTakeProfit(symbol, side, qty, tp)
            activate EXC
            EXC --> MGR: TP Response
            deactivate EXC

            alt TP set failed
                MGR -> MGR: Log warning (TP less critical than SL)
                MGR -> MGR: Schedule async TP retry
            else TP set successfully
                MGR -> DB: RecordTakeProfit(position_id, tp_order_id)
            end
        end

        MGR -> MGR: recordPositionEvent(OPEN)
        MGR -> MGR: assignVirtualPosition()
        note right
          Use actual fillQty from response
          Track position allocation per trader
        end note

    else Order Partially Filled (IOC)
        MGR -> MGR: Log partial fill
        MGR -> MGR: actualQty = resp.FilledQty

        note right
          **M3: Partial Fill Handling**:
          - IOC order partially filled
          - Expected qty: X
          - Actual filled qty: Y < X
          - Unfilled portion canceled

          **Action**: Accept partial fill
          - Record actual fill qty
          - No retry for unfilled portion
          - Adjust position size accordingly
          - ✅ Set SL/TP based on ACTUAL qty
        end note

        MGR -> MGR: recordPositionEvent(OPEN, actualQty)
        MGR -> MGR: assignVirtualPosition(actualQty)

        alt Stop-loss/Take-profit supported
            note right
              **Critical**: Use actualQty, not expectedQty
              Protection must match actual exposure
            end note

            MGR -> EXC: SetStopLoss(symbol, side, actualQty, sl)
            activate EXC
            EXC --> MGR: SL Response
            deactivate EXC

            alt SL set failed
                MGR -> MGR: Log CRITICAL error
                MGR -> EXC: ClosePosition(symbol)
                note right
                  Fail-safe: Close partial position
                  if cannot protect with SL
                end note
            else SL set successfully
                MGR -> DB: RecordStopLoss(position_id, sl_order_id)
            end

            MGR -> EXC: SetTakeProfit(symbol, side, actualQty, tp)
            activate EXC
            EXC --> MGR: TP Response
            deactivate EXC

            alt TP set successfully
                MGR -> DB: RecordTakeProfit(position_id, tp_order_id)
            end
        end

    else Order Failed (Rejected)
        MGR -> MGR: Log order failure
        note right
          **Failure Reasons**:
          - Insufficient margin
          - Symbol not found
          - Invalid parameters
          - Exchange rejection

          **Error Recovery**:
          - Log failure details
          - Do NOT retry (risk double-fill)
          - Report to Manager
          - May trigger trader pause
        end note

        MGR ->> DB: logError(order_rejected)
        MGR -> MGR: skipPositionAllocation()

    end

else Action = hold/wait
    MGR -> MGR: Skip execution
    note right: No market action needed
end

MGR -> MGR: Log execution summary
note right
  Final structured log:
  - Decision action/symbol
  - Execution result (ok/error)
  - Duration
  - Key metrics
end note

MGR --> MGR: Return execution result
deactivate MGR

note over MGR, DB
  **Design Notes:**
  1. Observability > Prevention
     - Comprehensive structured logging
     - Audit trail for debugging

  2. ✅ Enhanced Risk Protection (2025-11-18)
     - **H3**: Price staleness check (reject if >5s old)
     - **H2**: Stop-loss failure → protective close
     - **M3**: Partial fills use actual qty for SL/TP
     - **H4**: Cooldown persistence with retry queue

  3. Fail-safe mechanisms
     - Cannot set SL → close position immediately
     - Stale price → reject order or widen slippage
     - Partial fill → SL based on actual exposure

  4. Natural guarantees
     - CLOID provides deduplication
     - Exchange is source of truth
     - Allow eventual consistency

  5. Critical vs Best-effort
     - **Critical**: Stop-loss setting (retries + fail-safe)
     - **Best-effort**: Take-profit, leverage update
     - **Async retry**: Cooldown persistence

  6. Focus areas
     - Price snapshot timestamp tracking
     - Order response validation
     - Partial fill detection
     - Stop-loss confirmation
end note

@enduml
