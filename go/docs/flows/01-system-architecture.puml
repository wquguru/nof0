@startuml DDD-Based System Architecture
!theme plain

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam packageBorderColor #666666
skinparam packageBackgroundColor #FAFAFA
skinparam linetype ortho

' ==============================================================================
' Legend
' ==============================================================================
legend top left
  |<size:12><b>DDD Patterns</b></size> |
  |<back:#E3F2FD>   </back>| Aggregate Root |
  |<back:#FFF3E0>   </back>| Entity |
  |<back:#E8F5E9>   </back>| Value Object / Service |
  |<back:#FCE4EC>   </back>| Application Service |
  |<back:#FFF9C4>   </back>| Port (Interface) |
  |<back:#FFE0B2>   </back>| Adapter |
endlegend

' ==============================================================================
' TOP: External Systems
' ==============================================================================
package "External Systems" #EEEEEE {
    [LLM API] as LLM_EXTERNAL
    [Exchange API] as EXCHANGE_EXTERNAL
    database "PostgreSQL" as DB_EXTERNAL
}

' ==============================================================================
' LAYER 1: Application Layer (✅ P0-1: Split ManagerService)
' ==============================================================================
package "Application Layer" #FAFAFA {
    [DecisionOrchestrator] <<Application>> #FCE4EC
    [TraderLifecycleManager] <<Application>> #FCE4EC
    [RiskMonitor] <<Application>> #FCE4EC
}

note right of DecisionOrchestrator
  <b>Decision Orchestration</b>
  ✅ Refactored from ManagerService
  • Build execution context
  • Coordinate Executor & Validator
  • Manage transaction boundaries
  • Sort & cap new positions
end note

note right of TraderLifecycleManager
  <b>Trader Lifecycle</b>
  ✅ Refactored from ManagerService
  • Register/unregister traders
  • State machine transitions
  • Config hot-reload
  • Health monitoring
end note

note right of RiskMonitor
  <b>Risk Protection</b>
  ✅ Replaces RiskRunner
  • Periodic risk monitoring
  • Stop-loss / Take-profit triggers
  • Position health checks
  • Subscribe to domain events
end note

' ==============================================================================
' LAYER 2: Domain Layer
' ==============================================================================
package "Domain Layer" #FAFAFA {

    ' Left side: Trading Context (Core)
    package "Trading Context" #E1F5FE {
        rectangle "Trader Aggregate" <<Root>> #E3F2FD {
            [Trader] #E3F2FD

            note bottom of Trader
              <b>Encapsulates Runtime State:</b>
              • PerformanceMetrics
              • CashAllocation
              • Cooldowns
              • State (Running/Paused/Stopped)
            end note
        }

        [Position] <<Entity>> #FFF3E0
        [TraderConfig] <<Entity>> #E3F2FD
        [RiskParameters] <<VO>> #E8F5E9

        Trader -down-> Position : manages
        Trader -right-> TraderConfig : uses
        TraderConfig *-- RiskParameters
    }

    ' Center: Decision Context
    package "Decision Context" #F1F8E9 {
        [Executor] <<Service>> #E8F5E9
        [Decision] <<VO>> #E8F5E9
        [Context] <<DTO>> #FCE4EC
        [Validator] <<Service>> #E8F5E9

        Executor -down-> Decision : produces
        Executor -left-> Context : uses
        Executor -down-> Validator
    }

    ' Right side: Supporting Contexts
    package "Market Context" #FFF3E0 {
        [Asset] <<VO>> #E8F5E9
        [Snapshot] <<VO>> #E8F5E9

        note bottom of Asset
          Symbol + Metadata
          • Precision, Leverage
          • IsActive status
        end note
    }

    package "Event Domain" #E8EAF6 {
        [DecisionCycle] <<Event>> #E8F5E9
        [Trade] <<Event>> #E8F5E9
        () "DomainEvent" as DomainEvent
        () "EventBus" as EventBus

        note bottom of DecisionCycle
          ✅ Event Sourcing
          Append-only event log
          Enables replay & audit
        end note

        note right of EventBus
          <b>Event-Driven Architecture</b>
          • Publish/Subscribe pattern
          • Decouples components
          • Enables async processing
        end note
    }

    package "Risk Context" #FFEBEE {
        () "RiskGuard" as IRiskGuard
        [GuardChain] <<Service>> #E8F5E9

        note bottom of IRiskGuard
          <b>Strategy Pattern</b>
          • MaxPositionGuard
          • MarginUsageGuard
          • LiquidityGuard
          • CooldownGuard
        end note
    }
}

' ==============================================================================
' LAYER 3: Infrastructure Layer (Ports & Adapters)
' ==============================================================================
package "Infrastructure Layer" #FAFAFA {

    package "Ports (Interfaces)" #FFF9C4 {
        () "IAccountProvider" as IAccount
        () "IPositionProvider" as IPosition
        () "IOrderProvider" as IOrder
        () "IMarketProvider" as IMarket
        () "ILLMClient" as ILLM
        () "ITraderRepository" as ITraderRepo
        () "IPositionRepository" as IPositionRepo
        () "IDecisionCycleRepository" as IDecisionRepo
        () "ITradeRepository" as ITradeRepo
    }

    note right of IAccount
      <b>✅ P0-2: Interface Segregation</b>

      Refactored from fat IExchangeProvider
      into focused interfaces:

      <b>IAccountProvider</b>:
      • GetAccount() (*Account, error)
      • GetMarginSummary() (*Margin, error)

      <b>IPositionProvider</b>:
      • GetPositions() ([]Position, error)
      • ClosePosition(symbol) error

      <b>IOrderProvider</b>:
      • PlaceOrder(order) error
      • CancelOrder(orderID) error
      • SetLeverage(symbol, lev) error

      Each interface has 2-5 focused methods
      ✅ Follows ISP (Interface Segregation Principle)
      ✅ Easier to test with smaller mocks
      ✅ Clearer dependencies
    end note

    note right of ITraderRepo
      <b>✅ P0-2: Repository per Aggregate</b>

      Refactored from single IRepository:

      <b>ITraderRepository</b>:
      • Save(trader *Trader) error
      • FindByID(id) (*Trader, error)
      • FindByState(state) ([]*Trader, error)

      <b>IPositionRepository</b>:
      • Save(position *Position) error
      • FindByTraderID(id) ([]*Position, error)
      • FindOpenPositions() ([]*Position, error)

      <b>IDecisionCycleRepository</b>:
      • Append(cycle *DecisionCycle) error
      • ReplayAll(traderID) ([]*DecisionCycle, error)

      <b>ITradeRepository</b>:
      • Append(trade *Trade) error
      • FindByPositionID(id) ([]*Trade, error)

      ✅ One repository per aggregate root
      ✅ Type-safe (no interface{})
      ✅ Optimized for domain queries
    end note

    package "Adapters (Implementations)" #FFE0B2 {
        [HyperliquidAccountAdapter] <<Adapter>> #FFE0B2
        [HyperliquidPositionAdapter] <<Adapter>> #FFE0B2
        [HyperliquidOrderAdapter] <<Adapter>> #FFE0B2
        [HyperliquidMarket] as HLMarket <<Adapter>> #FFE0B2
        [LLMClient] <<Adapter>> #FFE0B2
        [PostgresTraderRepo] <<Adapter>> #FFE0B2
        [PostgresPositionRepo] <<Adapter>> #FFE0B2
        [PostgresDecisionCycleRepo] <<Adapter>> #FFE0B2
        [PostgresTradeRepo] <<Adapter>> #FFE0B2
        [AsyncEventBus] <<Adapter>> #FFE0B2
    }

    HyperliquidAccountAdapter .up.|> IAccount
    HyperliquidPositionAdapter .up.|> IPosition
    HyperliquidOrderAdapter .up.|> IOrder
    HLMarket .up.|> IMarket
    LLMClient .up.|> ILLM
    PostgresTraderRepo .up.|> ITraderRepo
    PostgresPositionRepo .up.|> IPositionRepo
    PostgresDecisionCycleRepo .up.|> IDecisionRepo
    PostgresTradeRepo .up.|> ITradeRepo
    AsyncEventBus .up.|> EventBus

    note bottom of HLMarket
      <b>With caching layer</b>
      • TTL-based snapshot cache (5s)
      • Symbol universe cache
      • Transparent to domain
    end note

    note bottom of PostgresTraderRepo
      <b>With caching layer</b>
      • go-zero cache integration
      • State snapshot cache
      • Invalidation on updates
    end note

    note bottom of AsyncEventBus
      <b>Event Bus Implementation</b>
      • Goroutine-based async dispatch
      • Channel buffering
      • Error handling & retries
    end note
}

' ==============================================================================
' DEPENDENCIES - Clean Architecture Flow (Top to Bottom)
' ==============================================================================

' Application -> Domain
DecisionOrchestrator -down-> Trader
DecisionOrchestrator -down-> Executor
DecisionOrchestrator -down-> GuardChain
DecisionOrchestrator -down-> EventBus
TraderLifecycleManager -down-> Trader
TraderLifecycleManager -down-> ITraderRepo
RiskMonitor -down-> Trader
RiskMonitor -down-> EventBus

' Domain -> Ports (Dependency Inversion)
Trader -down-> IAccount
Trader -down-> IPosition
Trader -down-> IOrder
Trader -down-> IMarket
Trader -down-> ITraderRepo
Executor -down-> ILLM
GuardChain -down-> IRiskGuard

' Domain Internal
Trader -right-> Context : builds
Context -up-> Snapshot : includes
Context -up-> Asset : includes
Trader -down-> Decision : executes
Trader -down-> DecisionCycle : records
Trader -down-> Trade : records
Trader -down-> DomainEvent : publishes

' Adapters -> External
HyperliquidAccountAdapter -up-> EXCHANGE_EXTERNAL
HyperliquidPositionAdapter -up-> EXCHANGE_EXTERNAL
HyperliquidOrderAdapter -up-> EXCHANGE_EXTERNAL
HLMarket -up-> EXCHANGE_EXTERNAL
LLMClient -up-> LLM_EXTERNAL
PostgresTraderRepo -up-> DB_EXTERNAL
PostgresPositionRepo -up-> DB_EXTERNAL
PostgresDecisionCycleRepo -up-> DB_EXTERNAL
PostgresTradeRepo -up-> DB_EXTERNAL

' ==============================================================================
' ARCHITECTURE SUMMARY
' ==============================================================================

note as ArchPrinciples
  <b><size:14>Architecture Principles</size></b>

  <b>1. DDD</b> - Trader as Aggregate Root
     • Encapsulates runtime state
     • Protects invariants
     ✅ Repository per aggregate

  <b>2. Hexagonal</b> - Ports isolate domain
     • Domain depends on interfaces
     • Adapters implement externals
     ✅ Interface segregation (ISP)

  <b>3. Dependency Inversion</b>
     • Domain → Abstractions (Ports)
     • Infrastructure → Implementations

  <b>4. Event Sourcing</b>
     • Immutable audit log
     • DecisionCycle + Trade events
     • Event bus for async processing

  <b>5. Caching Strategy</b>
     • Transparent to domain
     • Implemented in adapters
     • Multi-level (L1 + L2)

  <b>6. Single Responsibility</b>
     ✅ DecisionOrchestrator: Decision flow
     ✅ TraderLifecycleManager: State management
     ✅ RiskMonitor: Risk monitoring

  <b>✅ P0 Refactoring Completed</b>:
  • ManagerService split into 3 services
  • Repository split by aggregate root
  • IExchangeProvider split into focused interfaces
  • Event bus introduced for async processing
  • RiskGuard abstraction with chain pattern
end note

@enduml
