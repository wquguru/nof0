@startuml DDD-Based System Architecture
!theme plain

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam packageBorderColor #666666
skinparam packageBackgroundColor #FAFAFA
skinparam linetype ortho

' ==============================================================================
' Legend
' ==============================================================================
legend top left
  |<size:12><b>DDD Patterns</b></size> |
  |<back:#E3F2FD>   </back>| Aggregate Root |
  |<back:#FFF3E0>   </back>| Entity |
  |<back:#E8F5E9>   </back>| Value Object / Service |
  |<back:#FCE4EC>   </back>| Application Service |
  |<back:#FFF9C4>   </back>| Port (Interface) |
  |<back:#FFE0B2>   </back>| Adapter |
endlegend

' ==============================================================================
' TOP: External Systems
' ==============================================================================
package "External Systems" #EEEEEE {
    [LLM API] as LLM_EXTERNAL
    [Exchange API] as EXCHANGE_EXTERNAL
    database "PostgreSQL" as DB_EXTERNAL
}

' ==============================================================================
' LAYER 1: Application Layer
' ==============================================================================
package "Application Layer" #FAFAFA {
    [ManagerService] <<Application>> #FCE4EC
    [RiskRunner] <<Application>> #FCE4EC
}

note right of ManagerService
  <b>Decision Orchestration</b>
  • Trader lifecycle management
  • Decision cycle scheduling
  • Transaction boundaries
end note

note right of RiskRunner
  <b>Risk Protection</b>
  • Periodic risk monitoring
  • Stop-loss / Take-profit
  • Position health checks
end note

' ==============================================================================
' LAYER 2: Domain Layer
' ==============================================================================
package "Domain Layer" #FAFAFA {

    ' Left side: Trading Context (Core)
    package "Trading Context" #E1F5FE {
        rectangle "Trader Aggregate" <<Root>> #E3F2FD {
            [Trader] #E3F2FD

            note bottom of Trader
              <b>Encapsulates Runtime State:</b>
              • PerformanceMetrics
              • CashAllocation
              • Cooldowns
              • State (Running/Paused/Stopped)
            end note
        }

        [Position] <<Entity>> #FFF3E0
        [TraderConfig] <<Entity>> #E3F2FD
        [RiskParameters] <<VO>> #E8F5E9

        Trader -down-> Position : manages
        Trader -right-> TraderConfig : uses
        TraderConfig *-- RiskParameters
    }

    ' Center: Decision Context
    package "Decision Context" #F1F8E9 {
        [Executor] <<Service>> #E8F5E9
        [Decision] <<VO>> #E8F5E9
        [Context] <<DTO>> #FCE4EC
        [Validator] <<Service>> #E8F5E9

        Executor -down-> Decision : produces
        Executor -left-> Context : uses
        Executor -down-> Validator
    }

    ' Right side: Supporting Contexts
    package "Market Context" #FFF3E0 {
        [Asset] <<VO>> #E8F5E9
        [Snapshot] <<VO>> #E8F5E9

        note bottom of Asset
          Symbol + Metadata
          • Precision, Leverage
          • IsActive status
        end note
    }

    package "Event Domain" #E8EAF6 {
        [DecisionCycle] <<Entity>> #FFF3E0
        [Trade] <<Entity>> #FFF3E0

        note bottom of DecisionCycle
          Append-only event log
          Enables replay & audit
        end note
    }
}

' ==============================================================================
' LAYER 3: Infrastructure Layer (Ports & Adapters)
' ==============================================================================
package "Infrastructure Layer" #FAFAFA {

    package "Ports (Interfaces)" #FFF9C4 {
        () "IExchangeProvider" as IExchange
        () "IMarketProvider" as IMarket
        () "ILLMClient" as ILLM
        () "IRepository" as IRepo
    }

    note right of IExchange
      <b>⚠️ Design Trade-off: Fat Interface</b>

      **Current Methods** (~15+ methods):
      • Account: GetAccount(), GetMarginSummary()
      • Position: GetPositions(), ClosePosition()
      • Order: PlaceOrder(), CancelOrder()
      • Leverage: SetLeverage(), GetAssetIndex()
      • Market: SetMarkPrice(), GetOrderbook()

      **ISP Violation**: Interface Segregation Principle
      - Most consumers use only 3-5 methods
      - Violates "clients should not depend on
        methods they do not use"

      **Recommended Refactor** (future):
      ```go
      type IAccountProvider interface {
        GetAccount() (*Account, error)
        GetMarginSummary() (*Margin, error)
      }

      type IPositionProvider interface {
        GetPositions() ([]Position, error)
        ClosePosition(symbol) error
      }

      type IOrderProvider interface {
        PlaceOrder(order) error
        SetLeverage(symbol, lev) error
      }
      ```

      **Why Not Refactored Yet**:
      1. **Implementation simplicity**: Single
         adapter easier to maintain initially
      2. **Cohesion**: All methods operate on
         same exchange connection/state
      3. **Performance**: Shared rate limiter,
         connection pool, WebSocket stream
      4. **Defer until pain**: Only 2 adapters
         (Hyperliquid + Mock), cost/benefit low

      **Trigger for Refactor**:
      - Adding 3+ exchange adapters
      - Different teams own different parts
      - Testing becomes cumbersome
    end note

    package "Adapters (Implementations)" #FFE0B2 {
        [HyperliquidExchange] as HLExchange <<Adapter>> #FFE0B2
        [HyperliquidMarket] as HLMarket <<Adapter>> #FFE0B2
        [LLMClient] <<Adapter>> #FFE0B2
        [PostgresRepository] as PGRepo <<Adapter>> #FFE0B2
    }

    HLExchange .up.|> IExchange
    HLMarket .up.|> IMarket
    LLMClient .up.|> ILLM
    PGRepo .up.|> IRepo

    note bottom of HLMarket
      <b>With caching layer</b>
      • TTL-based snapshot cache
      • Symbol universe cache
    end note

    note bottom of PGRepo
      <b>With caching layer</b>
      • go-zero cache integration
      • State snapshot cache
    end note
}

' ==============================================================================
' DEPENDENCIES - Clean Architecture Flow (Top to Bottom)
' ==============================================================================

' Application -> Domain
ManagerService -down-> Trader
ManagerService -down-> Executor
RiskRunner -down-> Trader

' Domain -> Ports (Dependency Inversion)
Trader -down-> IExchange
Trader -down-> IMarket
Trader -down-> IRepo
Executor -down-> ILLM

' Domain Internal
Trader -right-> Context : builds
Context -up-> Snapshot : includes
Context -up-> Asset : includes
Trader -down-> Decision : executes
Trader -down-> DecisionCycle : records
Trader -down-> Trade : records

' Adapters -> External
HLExchange -up-> EXCHANGE_EXTERNAL
HLMarket -up-> EXCHANGE_EXTERNAL
LLMClient -up-> LLM_EXTERNAL
PGRepo -up-> DB_EXTERNAL

' ==============================================================================
' ARCHITECTURE SUMMARY
' ==============================================================================

note as ArchPrinciples
  <b><size:14>Architecture Principles</size></b>

  <b>1. DDD</b> - Trader as Aggregate Root
     • Encapsulates runtime state
     • Protects invariants

  <b>2. Hexagonal</b> - Ports isolate domain
     • Domain depends on interfaces
     • Adapters implement externals

  <b>3. Dependency Inversion</b>
     • Domain → Abstractions (Ports)
     • Infrastructure → Implementations

  <b>4. Event Sourcing</b>
     • Immutable audit log
     • DecisionCycle + Trade entities

  <b>5. Caching Strategy</b>
     • Transparent to domain
     • Implemented in adapters
end note

@enduml
